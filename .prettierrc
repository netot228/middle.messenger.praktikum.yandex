{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "plugins": [
    "@poliklot/prettier-plugin-handlebars"
  ],
  "overrides": [
    {
      "files": "*.hbs",
      "options": {
        "parser": "handlebars"
      }
    }
  ]
}