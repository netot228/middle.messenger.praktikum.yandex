<div class="chat">
  <div class="chat-aside">

    <aside class="chat-aside-header">

      {{> ActionLink
        href="/#page=profile"
        text=""
        class_modificator="chat-setting-button"
      }}

      <form class="chat-search">
        {{> Input
          type="text"
          name='search'
          input_id="_id_input_search"
          label="Поиск"
          class_modificator="chat-search-field"
        }}
        {{> ActionButton
          type='submit'
          class_modificator='chat-search-button'
        }}
      </form>

    </aside>

    <nav class="chat-list">

      <ul class="chat-list-wrapper">
        {{#each chats}}
          {{> ChatItem}}
        {{/each}}
      </ul>
    </nav>

  </div>
  <div class="chat-mainarea">

    {{#if dialog}}
      <div class="chat-mainarea-wrapper">
        <div class="chat-mainarea-header">
          {{> Avatar
            avatarUrl=dialog.avatar
            name=dialog.title
          }}
          <h1 class="title">{{ dialog.title }}</h1>

          <div class="menu">
            {{!-- открытие меню пока по ховеру --}}
            {{> ActionButton
              type='button'
              class_modificator='menu-button'
            }}

            <div class="menu-content" data-userid="{{ dialog.id }}">
              {{> ActionLink
                href="/#page=chat&user_add=true"
                text="Добавить пользователя"
                class_modificator="add-user"
              }}
              {{!-- пока непонтяно как в строку параметра подставить значение переменной {{ dialog.id }} --}}
              {{> ActionLink
                href="/#page=chat&user_delete=true&id=123"
                text="Удалить пользователя"
                class_modificator="delete-user"
              }}
            </div>
          </div>
        </div>

        <div class="chat-mainarea-dialog">
          <ul class="chat-mainarea-dialog-wrapper">
            {{#each dialog.messages}}
              <li class="message {{ sender }}" data-messageid="{{ id }}">{{{ html }}}</li>
            {{/each}}
          </ul>

        </div>

        <div class="chat-mainarea-sendzone">
          <form class="chat-mainarea-form" data-id="_id_chat_form">
            <div class="media">
              {{!-- открытие меню пока по ховеру --}}
              {{> ActionButton
                type='button'
                class_modificator='media-button'
              }}
              <div class="media-content">
                {{> Input
                  type="file"
                  name='file'
                  input_id="_id_send_picture_to_chat"
                  label="Загрузить картинку"
                  needLabel="true"
                  class_modificator="add_picture"
                }}
                {{> Input
                  type="file"
                  name='file'
                  input_id="_id_send_file_to_chat"
                  label="Загрузить файл"
                  needLabel="true"
                  class_modificator="add_file"
                }}
              </div>
            </div>

            <textarea
              id="_id_chat_input"
              name="message"
              rows="1"
              data-id="_id_chat_input"
              placeholder="Сообщение"
            ></textarea>

            {{> EmojiSet}}

            {{> ActionButton
              type='submit'
              class_modificator="send-message-button"
            }}
          </form>
        </div>
      </div>
    {{else}}
      <div class="chat-mainarea-entry">Выберите чат чтобы отправить сообщение</div>
    {{/if}}

  </div>
</div>
