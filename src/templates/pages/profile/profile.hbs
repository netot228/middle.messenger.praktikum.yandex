<div id="_id_profile_container" class="profile">
  <div class="profile-aside">
    {{!-- по клику на actionLink здесь надо делать history.go(-1) --}}
    {{> ActionLink
      href="/#page=chat"
      class_modificator="back"
    }}
  </div>

  <div class="profile-mainarea">
    <div class="profile-data">

      <form id="_id_profile_avatar_form" class="form">
        <div class="photo">
          {{> Avatar
            avatarUrl=avatar
            name=login
          }}
          {{> Input
            type="file"
            name='file'
            input_id="_id_upload_avatar"
            label="Загрузить картинку"
            needLabel="true"
            class_modificator="photo-upload"
          }}
        </div>
        <h1 class="name">{{ display_name }}</h1>
      </form>
      <form id="_id_profile_main_form" class="form">

        <div class="form-part form-profile-data">
          {{> Input
            type="text"
            name="email"
            input_id="_id_input_email"
            needLabel="true"
            label="Почта"
            alert_message="Обязательное поле"
            disabled="disabled"
            value=email
          }}

          {{> Input
            type="text"
            name="login"
            input_id="_id_input_login"
            needLabel="true"
            label="Логин"
            alert_message="Обязательное поле"
            disabled="disabled"
            value=login
          }}

          {{> Input
            type="text"
            name="first_name"
            input_id="_id_input_first_name"
            needLabel="true"
            label="Имя"
            alert_message="Обязательное поле"
            disabled="disabled"
            value=first_name
            disabled="disabled"
          }}

          {{> Input
            type="text"
            name="second_name"
            input_id="_id_input_second_name"
            needLabel="true"
            label="Фамилия"
            value=second_name
            disabled="disabled"
          }}

          {{> Input
            type="text"
            name="display_name"
            input_id="_id_input_display_name"
            needLabel="true"
            label="Имя в чате"
            value=display_name
            disabled="disabled"
          }}

          {{> Input
            type="text"
            name="phone"
            input_id="_id_input_phone"
            needLabel="true"
            label="Телефон"
            alert_message="Обязательное поле"
            value=phone
            disabled="disabled"
          }}
        </div>

      </form>

      <form id="_id_profile_pass_form" class="form">
        <div class="form-part form-password-change">
          {{> Input
            type="password"
            name="old_password"
            input_id="_id_input_old_password"
            needLabel="true"
            label="Текущий пароль"
            alert_message="Обязательное поле"
            value="123456"
          }}
          {{> Input
            type="password"
            name="new_password"
            input_id="_id_input_new_password"
            needLabel="true"
            label="Новый пароль"
            alert_message="Обязательное поле"
            value=""
          }}

          {{> Input
            type="password"
            name="new_password_confirm"
            input_id="_id_input_password_new_password_confirm"
            needLabel="true"
            label="Новый пароль (еще раз)"
            alert_message="Обязательное поле"
            value=""
          }}
        </div>

        {{> ActionButton
          type="submit"
          title="Сохранить"
          class_modificator="profile-submit"
        }}

      </form>

      <div class="action-buttons" data-id="profile_main_btns">

          {{> ActionLink
            href="/#page=profile&edit=true"
            text="Изменить данные"
          }}

          {{> ActionLink
            href="/#page=profile&change_pass=true"
            text="Изменить пароль"
          }}
          {{> ActionLink
            href="/"
            text="Выйти"
            class_modificator="accent"
          }}

        </div>

    </div>

  </div>
</div>
</div>
