<div class='registration'>

  <!-- выводим статику с формой без экшенов на сабмит -->
  <form class="form">

    <h1 class="form-title">{{title}}</h1>

    {{> TextInput
        type="text"
        name='mail'
        input_id="_id_input_mail"
        label="Почта"
        alert_message="Обязательное поле" }}

    {{> TextInput
        type="text"
        name='login'
        input_id="_id_input_login"
        label="Логин"
        alert_message="Обязательное поле" }}

    {{> TextInput
        type="text"
        name='name'
        input_id="_id_input_name"
        label="Имя"
        alert_message="Обязательное поле" }}

    {{> TextInput
        type="text"
        name='surname'
        input_id="_id_input_surname"
        label="Фамилия" }}

    {{> TextInput
        type="text"
        name='phone'
        input_id="_id_input_phone"
        label="Телефон"
        alert_message="Обязательное поле" }}

    {{> TextInput
        type="password"
        name='password'
        input_id="_id_input_password"
        label="Пароль"
        alert_message="Обязательное поле" }}

    {{> TextInput
        type="password"
        name='password_repeat'
        input_id="_id_input_password_repeat"
        label="Пароль (еще раз)"
        alert_message="Обязательное поле" }}

    <div class="login-btn-place">
      <!--  ActionButton пока будет просто button -->
      {{> ActionButton button_type='button' title="Зарегистироваться" }}
      {{!-- {{> MinorButton button_type='button' title="Регистрация" }} --}}
      {{> ActionLink href="/" text="Войти" class_modificator="likeBtn"}}
    </div>

  </form>

</div>
